{
    "name": "train",
    "phase": "train",
    "gpu_ids": "1",
    "display_port": 8097,
    "path": {
        "log": "logs",
        "tb_logger": "tb_logger",
        "results": "results",
        "checkpoint": "checkpoint",
        "resume_state": null
    },
    "datasets": {
        "train": {
            "name": "shoulder_joint_landmarks",
            "cacheroot": "<DATA_ROOT>/cache/scapula",
            "trainroot": "<DATA_ROOT>/train",
            "validroot": "<DATA_ROOT>/valid",
            "image_size": [256, 256, 256],
            "target_size": [256, 256, 256],
            "batch_size": 1,
            "num_workers": 8,
            "use_shuffle": false,
            "heat_sigma": 2,
            "points_part": "scapula",
            "rebuild_cache": false
        }
    },
    "train": {
        "loss_fc": "bmc",
        "n_epoch": 500,
        "save_checkpoint_epoch": 50,
        "val_freq": 50,
        "print_freq": 20,
        "loss_lambda": 20,
        "early_stop_patience": 30,
        "optimizer": {
            "type": "adam",
            "lr": 1e-5,
            "weight_decay": 1e-5
        },
        "pt_weight_scheduler": {
            "start_epoch": 100,
            "update_interval": 20,
            "clip_max": 1.5,
            "clip_min": 0.8
        }
    }
}
    
